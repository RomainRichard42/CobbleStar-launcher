{
  "name": "cobblestar-launcher",
  "private": true,
  "version": "0.3.0",
  "description": "Launcher officiel du serveur Minecraft CobbleStar",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:web": "tsc -b && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:web && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "publish:win": "npm run build && electron-builder --win --x64 --publish always",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.3",
    "@vitejs/plugin-react": "latest",
    "@xmcl/user": "^4.4.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "fr.cobblestar.launcher",
    "productName": "CobbleStar Launcher",
    "artifactName": "CobbleStar-Launcher-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "RomainRichard42",
      "repo": "CobbleStar-launcher",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "launcher.config.json",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
